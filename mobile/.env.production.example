# =============================================================================
# Production environment — NEVER commit a filled copy.
# Copy to a secret store / host env. Isolate from staging credentials entirely.
# =============================================================================

# --- Client (build-time public) ---
VITE_API_URL=https://api.helcalafkaaga.com
VITE_SOCKET_URL=https://api.helcalafkaaga.com
VITE_APP_URL=https://app.helcalafkaaga.com
VITE_USE_LOCAL_DEMO=false
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# --- Nest API ---
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://hel:REPLACE_ME@PROD_PG_HOST:5432/hel_calafkaaga?schema=public&sslmode=require
REDIS_URL=redis://:REPLACE_ME@PROD_REDIS_HOST:6379
SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS____________
COOKIE_SECURE=true
COOKIE_DOMAIN=.helcalafkaaga.com
CORS_ORIGINS=https://app.helcalafkaaga.com,capacitor://localhost,https://localhost
TRUST_PROXY=true
APP_URL=https://app.helcalafkaaga.com

# Object storage (private buckets; signed URLs only to clients)
S3_ENDPOINT=https://REPLACE_R2_OR_S3_ENDPOINT
S3_REGION=auto
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=300
S3_BUCKET_PROFILE=hel-profile
S3_BUCKET_PROFILE_PRIVATE=hel-profile-private
S3_BUCKET_CHAT=hel-chat
S3_BUCKET_SUPPORT=hel-support
S3_BUCKET_EVC=hel-evc

# Mail
MAIL_DRIVER=resend
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM=Tel Calafkaaga <support@helcalafkaaga.com>

# Stripe — live keys only in production secret store
STRIPE_GATEWAY=live
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_ALLOW_LIVE=true

# Optional error reporting (leave empty until keys provisioned)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# --- Infra (if self-hosting compose) ---
POSTGRES_USER=hel
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=hel_calafkaaga
