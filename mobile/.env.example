# =============================================================================
# Hel Calafkaaga — environment variable reference (NO REAL SECRETS)
# =============================================================================
# Copy values into the correct local file:
#   - apps/api/.env          → Nest API (authoritative backend)
#   - infra/.env             → Docker Compose for Postgres/Redis/MinIO
#   - apps/client/.env       → optional Vite client (public URLs only)
# Never commit real .env files.
# =============================================================================

# --- Client (public only) ---
# VITE_API_URL=http://127.0.0.1:4000
# VITE_SOCKET_URL=http://127.0.0.1:4000
# VITE_APP_URL=http://localhost:5173
# VITE_USE_LOCAL_DEMO=false
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Nest API (apps/api/.env) — see apps/api/.env.example for the full set ---
# DATABASE_URL=postgresql://hel:CHANGE_ME@localhost:5432/hel_calafkaaga?schema=public
# REDIS_URL=redis://127.0.0.1:6379
# SESSION_SECRET=change_me_to_a_long_random_string
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# S3_ENDPOINT / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / buckets
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET (test mode locally)
# MAIL_DRIVER=console | resend

# --- Infra Docker (infra/.env) ---
# POSTGRES_USER=hel
# POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_DB=hel_calafkaaga
# MINIO_ROOT_USER=helminio
# MINIO_ROOT_PASSWORD=CHANGE_ME
