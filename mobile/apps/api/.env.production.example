# Production API environment (copy into secret manager — never commit filled)
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://hel:REPLACE_ME@PROD_PG_HOST:5432/hel_calafkaaga?schema=public&sslmode=require
REDIS_URL=redis://:REPLACE_ME@PROD_REDIS_HOST:6379

SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS______
COOKIE_SECURE=true
# Prefer host-only cookies on the API hostname (leave COOKIE_DOMAIN unset).
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
# Website + any HTTPS app host. Capacitor (https://localhost, capacitor://localhost) is always allowed in code.
CORS_ORIGINS=https://www.helcalafkaaga.com,https://helcalafkaaga.com,https://app.helcalafkaaga.com
TRUST_PROXY=true
APP_URL=https://www.helcalafkaaga.com

S3_ENDPOINT=https://REPLACE_ENDPOINT
S3_REGION=auto
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=300
S3_BUCKET_PROFILE=hel-profile
S3_BUCKET_PROFILE_PRIVATE=hel-profile-private
S3_BUCKET_CHAT=hel-chat
S3_BUCKET_SUPPORT=hel-support
S3_BUCKET_EVC=hel-evc

MAIL_DRIVER=resend
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM=Hel Calafkaaga <noreply@helcalafkaaga.com>

STRIPE_GATEWAY=live
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_ALLOW_LIVE=true

# WaafiPay API_PURCHASE (never commit real keys)
# WAAFI_MERCHANT_UID=
# WAAFI_API_USER_ID=
# WAAFI_API_KEY=
# WAAFI_ENV=live

# L4: enable only after at least one owner enrolled MFA
# REQUIRE_STAFF_MFA=true

# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
