# Public client env only — never put secrets here.
#
# --- Physical phone / Render (production Vite build) ---
# Prefer apps/client/.env.production (gitignored) or pass at build time:
#   VITE_API_URL=https://tel-calafkaaga-1.onrender.com \
#   VITE_SOCKET_URL=https://tel-calafkaaga-1.onrender.com \
#   VITE_USE_LOCAL_DEMO=false \
#   npm run build -w @hel/client
#
# --- Local Android emulator → host machine API ---
VITE_API_URL=http://10.0.2.2:4000
VITE_SOCKET_URL=http://10.0.2.2:4000
VITE_APP_URL=http://localhost:5173
# iOS Simulator / desktop web often use:
# VITE_API_URL=http://127.0.0.1:4000
# VITE_SOCKET_URL=http://127.0.0.1:4000
# Physical device against local API: use your LAN IP, e.g. http://192.168.1.10:4000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Must stay false for production / store / phone-against-Render builds
VITE_USE_LOCAL_DEMO=false
