<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Deny backup of app data that may include Preferences with UI drafts.
         Auth tokens live in Android Keystore-backed secure storage and are
         already outside XML backup; keep backup disabled at application level. -->
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
