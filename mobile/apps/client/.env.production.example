# Public client env for production / App Store / TestFlight builds.
# Copy to apps/client/.env.production (gitignored) or pass the same vars at build time.
#
# iOS ATS requires HTTPS — do not use http://localhost in store archives.
# Never put DATABASE_URL, Redis, session secrets, Waafi secrets, or Stripe secret keys here.

VITE_API_URL=https://api.helcalafkaaga.com
VITE_SOCKET_URL=https://api.helcalafkaaga.com
VITE_APP_URL=https://www.helcalafkaaga.com
VITE_USE_LOCAL_DEMO=false

# Optional: only if website Stripe is ever re-enabled in the mobile UI (currently Waafi-only).
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME
