# Production Safari-safe browser API (same-origin proxy on Vercel):
#
# Browser → https://web.example.com/backend/...  (first-party cookies)
# Vercel rewrite → https://api.example.com/...
#
# Optional later: custom domain https://api.web.example.com (also same-site).
# Keep the Render URL as upstream / rollback — do not use it as NEXT_PUBLIC_* for
# Safari browsers (third-party cookies are blocked).
#
# Paste into Vercel → Project → Settings → Environment Variables
# Custom domain: https://web.example.com (and apex https://web.example.com)
#
# IMPORTANT: These NEXT_PUBLIC_* vars must be set BEFORE / during the Vercel
# build (not only runtime). After changing them, trigger a Redeploy.

NEXT_PUBLIC_APP_URL=https://web.example.com
# Relative → same-origin /backend rewrite in next.config.ts (Safari session cookies).
NEXT_PUBLIC_API_URL=/backend
# Omit SOCKET_URL (or set same-origin) so Socket.IO shares the page host + hel_session.
# NEXT_PUBLIC_SOCKET_URL=same-origin
#
# REALTIME CAVEAT (same-origin socket): browser → /socket.io → Next rewrite →
# API. That proxy path carries HTTP long-polling only (no WebSocket upgrade),
# and long-polling needs the API to be ONE instance or to use sticky sessions —
# otherwise the follow-up poll can land on another instance and engine.io
# answers 400 "unknown sid". The @socket.io/redis-adapter shares room fan-out,
# NOT polling sessions. Fixes:
#   - Render: scale the API to 1 instance, or enable session affinity.
#   - Better: give the API its own subdomain (api.web.example.com → Render) and
#     set NEXT_PUBLIC_SOCKET_URL to it. Real wss:// works, polling stays on one
#     host. Keep cookies first-party with COOKIE_DOMAIN=.web.example.com and add
#     the subdomain to CORS_ORIGINS. The web client auto-detects a distinct
#     socket origin and does WebSocket-first (see src/data/realtime/socket-client.ts).
#
# Server-only upstream for Next rewrites (not exposed to the browser):
API_UPSTREAM_URL=https://api.example.com

# ---------------------------------------------------------------------------
# Render Nest service env (Dashboard → your Render service → Environment)
#
# With the same-origin /backend proxy, cookies are set for web.example.com
# (host-only). Leave COOKIE_DOMAIN unset. SameSite=Lax + Secure.
#
# Deploy order:
#   1. Deploy Nest with cookie/CORS below (restart).
#   2. Set Vercel NEXT_PUBLIC_API_URL=/backend + API_UPSTREAM_URL; Redeploy.
#   3. iPhone Safari: login → hel_session on web.example.com → reload stays in.
#   4. Optional later: add api.web.example.com and point NEXT_PUBLIC_* there instead.
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://web.example.com,https://web.example.com
APP_URL=https://web.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=   # leave unset
TRUST_PROXY=true
# DATABASE_URL=<Render Postgres URL>
# REDIS_URL=...
# SESSION_SECRET=<min 32 chars>
#
# R2 CORS — run: set -a && source WEB-API.env && set +a && ./infra/staging/apply-r2-cors.sh
# S3_BUCKET_PROFILE=hel-profile
# S3_BUCKET_PROFILE_PRIVATE=hel-profile-private
# S3_BUCKET_CHAT=hel-chat
# S3_BUCKET_SUPPORT=hel-support
# S3_BUCKET_EVC=hel-evc
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
