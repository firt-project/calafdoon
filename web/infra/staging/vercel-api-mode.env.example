# Production Safari-safe browser API (same-origin proxy on Vercel):
#
# Browser → https://helcalafkaaga.com/backend/...  (first-party cookies)
# Vercel rewrite → https://tel-calafkaaga-1.onrender.com/...
#
# Optional later: custom domain https://api.helcalafkaaga.com (also same-site).
# Keep the Render URL as upstream / rollback — do not use it as NEXT_PUBLIC_* for
# Safari browsers (third-party cookies are blocked).
#
# Paste into Vercel → Project → Settings → Environment Variables
# Custom domain: https://www.helcalafkaaga.com (and apex https://helcalafkaaga.com)
#
# IMPORTANT: These NEXT_PUBLIC_* vars must be set BEFORE / during the Vercel
# build (not only runtime). After changing them, trigger a Redeploy.

NEXT_PUBLIC_APP_URL=https://www.helcalafkaaga.com
# Relative → same-origin /backend rewrite in next.config.ts (Safari session cookies).
NEXT_PUBLIC_API_URL=/backend
# Omit SOCKET_URL (or set same-origin) so Socket.IO shares the page host + hel_session.
# NEXT_PUBLIC_SOCKET_URL=same-origin
#
# Server-only upstream for Next rewrites (not exposed to the browser):
API_UPSTREAM_URL=https://tel-calafkaaga-1.onrender.com

# ---------------------------------------------------------------------------
# Render Nest service env (Dashboard → tel-calafkaaga-1 → Environment)
#
# With the same-origin /backend proxy, cookies are set for helcalafkaaga.com
# (host-only). Leave COOKIE_DOMAIN unset. SameSite=Lax + Secure.
#
# Deploy order:
#   1. Deploy Nest with cookie/CORS below (restart).
#   2. Set Vercel NEXT_PUBLIC_API_URL=/backend + API_UPSTREAM_URL; Redeploy.
#   3. iPhone Safari: login → hel_session on helcalafkaaga.com → reload stays in.
#   4. Optional later: add api.helcalafkaaga.com and point NEXT_PUBLIC_* there instead.
# ---------------------------------------------------------------------------
CORS_ORIGINS=https://www.helcalafkaaga.com,https://helcalafkaaga.com
APP_URL=https://www.helcalafkaaga.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=   # leave unset
TRUST_PROXY=true
# DATABASE_URL=<Render Postgres URL>
# REDIS_URL=...
# SESSION_SECRET=<min 32 chars>
#
# R2 CORS — run: set -a && source TEL-CALAFKAAGA-1.env && set +a && ./infra/staging/apply-r2-cors.sh
# S3_BUCKET_PROFILE=hel-profile
# S3_BUCKET_PROFILE_PRIVATE=hel-profile-private
# S3_BUCKET_CHAT=hel-chat
# S3_BUCKET_SUPPORT=hel-support
# S3_BUCKET_EVC=hel-evc
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
