# Copy to infra/.env for local Docker Compose (never commit real secrets)
POSTGRES_USER=hel
POSTGRES_PASSWORD=hel_dev_change_me
POSTGRES_DB=hel_calafkaaga

# Redis (M12) — required for local Compose requirepass. Use a URL-safe value.
# Match apps/api/.env REDIS_URL / REDIS_PASSWORD when running Nest on the host.
REDIS_PASSWORD=change-me

# MinIO (local S3-compatible — Phase 3 testing only; NOT Cloudflare R2)
MINIO_ROOT_USER=helminio
MINIO_ROOT_PASSWORD=hel_minio_dev_change_me
S3_REGION=us-east-1
