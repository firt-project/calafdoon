# Local API environment (copy to .env — never commit secrets)
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL — local Docker Compose only
DATABASE_URL=postgresql://hel:hel_dev_change_me@localhost:5432/hel_calafkaaga?schema=public

# Redis — BullMQ score queue + rate limits (Phase 6)
# Local Compose requires REDIS_PASSWORD (see infra/.env.example). Prefer embedding
# the password in REDIS_URL, or set REDIS_PASSWORD and keep a host-only URL.
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379
# Production (Render/Upstash): use the managed authenticated URL only — do not set
# a separate REDIS_PASSWORD unless the URL has no credentials.

# MinIO / S3-compatible object storage (local Phase 3 only — NOT Cloudflare R2)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=helminio
S3_SECRET_ACCESS_KEY=hel_minio_dev_change_me
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300

# Private buckets by purpose (created by infra/minio-init.sh)
S3_BUCKET_PROFILE=hel-profile
S3_BUCKET_PROFILE_PRIVATE=hel-profile-private
S3_BUCKET_CHAT=hel-chat
S3_BUCKET_SUPPORT=hel-support
S3_BUCKET_EVC=hel-evc

# Phase 4 auth (local only — never use production Resend here)
SESSION_SECRET=hel_dev_session_secret_change_me_32
COOKIE_SECURE=false
# Cookie SameSite (COOKIE_SAMESITE):
#   Default in code is lax (same-site: helcalafkaaga.com ↔ api.helcalafkaaga.com).
#   Production (api.helcalafkaaga.com): COOKIE_SECURE=true, COOKIE_SAMESITE=lax, leave COOKIE_DOMAIN unset.
#   Legacy cross-site (*.onrender.com browser traffic only): COOKIE_SAMESITE=none (+ Secure).
COOKIE_SAMESITE=
# Leave unset for host-only cookies on the API hostname (preferred).
COOKIE_DOMAIN=
CORS_ORIGINS=http://localhost:3020,http://127.0.0.1:3020,http://localhost:3001,http://127.0.0.1:3001
# Production (Render custom domain api.helcalafkaaga.com): set explicitly — no preview hosts hardcoded (L5).
# CORS_ORIGINS=https://www.helcalafkaaga.com,https://helcalafkaaga.com
# Optional: append a specific Vercel preview origin only when needed.
TRUST_PROXY=false
APP_URL=http://localhost:3020
MAIL_DRIVER=console
# L4 staff MFA: keep unset/false until at least one production owner has
# enrolled and verified TOTP + recovery-code login. Then set REQUIRE_STAFF_MFA=true
# so unenrolled admin/owner sessions are restricted to MFA enrollment only.
# REQUIRE_STAFF_MFA=false
# Production Render MUST use:
# MAIL_DRIVER=resend
# RESEND_API_KEY=re_...          (or legacy AUTH_RESEND_KEY)
# RESEND_FROM=Hel Calafkaaga <noreply@helcalafkaaga.com>
#   (or legacy AUTH_EMAIL_FROM — Nest accepts both)
# APP_URL=https://www.helcalafkaaga.com
# NEXT_PUBLIC_* (Vercel): API + socket → https://api.helcalafkaaga.com
# COOKIE_SECURE=true COOKIE_SAMESITE=lax TRUST_PROXY=true (COOKIE_DOMAIN unset)
# Rollback API host (internal only): https://tel-calafkaaga-1.onrender.com
# RESEND_API_KEY=
# RESEND_FROM=Hel Calafkaaga <noreply@helcalafkaaga.com>
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=Hel Calafkaaga <noreply@helcalafkaaga.com>

# Stripe — local/tests may use fake. NEVER set STRIPE_GATEWAY=fake on Render/production
# (startup will fail). Production: omit STRIPE_GATEWAY or set live + real keys.
STRIPE_GATEWAY=fake
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_test_replace_me
# M5 webhook abuse controls (optional — defaults shown)
# STRIPE_WEBHOOK_MAX_BODY_BYTES=262144
# STRIPE_WEBHOOK_RATE_IP_MAX=300
# STRIPE_WEBHOOK_RATE_IP_WINDOW_SEC=60
# STRIPE_WEBHOOK_RATE_GLOBAL_MAX=2000
# STRIPE_WEBHOOK_RATE_GLOBAL_WINDOW_SEC=60
# M6: reclaim stuck processing claims after this many ms (default 300000 = 5m)
# STRIPE_WEBHOOK_STALE_PROCESSING_MS=300000
# Production Render: set TRUST_PROXY=true so per-IP limits use the proxy client IP.
# STRIPE_ALLOW_LIVE must never be true in local Phase 8
# Production Render example:
# STRIPE_GATEWAY=live
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_ALLOW_LIVE=true
# TRUST_PROXY=true

# WaafiPay API_PURCHASE — set on Render (never commit real keys)
# Docs: https://docs.waafipay.com/purchase-api
# WAAFI_MERCHANT_UID=
# WAAFI_API_USER_ID=
# WAAFI_API_KEY=
# WAAFI_ENV=live
# Optional override:
# WAAFI_BASE_URL=https://api.waafipay.net/asm
# Sandbox:
# WAAFI_ENV=sandbox
# WAAFI_BASE_URL=https://sandbox.waafipay.com/asm

# Paystack transaction API — set on the API host (Render), never Vercel / never commit.
# Docs: https://paystack.com/docs/api/transaction  |  see web/docs/PAYSTACK.md
# Register this webhook URL in the Paystack dashboard: {API origin}/webhooks/paystack
# PAYSTACK_SECRET_KEY=sk_live_...   # use sk_test_... in staging
# PAYSTACK_PUBLIC_KEY=pk_live_...
# PAYSTACK_CURRENCY=USD             # must match your Paystack settlement currency
# PAYSTACK_USD_RATE=                # units of PAYSTACK_CURRENCY per 1 USD; required when not USD (e.g. KES ~130)
